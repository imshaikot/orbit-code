{
  "name": "@orbit-code/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "watch": "nx run vscode:watch",
    "typecheck": "nx run-many -t typecheck",
    "boundaries": "node tools/scripts/check-boundaries.mjs",
    "self": "node apps/vscode/scripts/run-self.mjs",
    "install-local": "node apps/vscode/scripts/install-local.mjs",
    "package": "nx run vscode:package",
    "index": "node packages/indexer/dist/indexer.mjs",
    "harness": "nx run harness:e2e --",
    "smoke": "nx run vscode:smoke"
  },
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "nx": "23.2.1",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.9.4"
}
