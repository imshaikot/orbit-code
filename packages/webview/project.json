{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "webview",
  "projectType": "library",
  "sourceRoot": "packages/webview/src",
  "tags": ["type:lib", "runtime:browser"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node build.mjs", "cwd": "{projectRoot}" },
      "configurations": { "production": { "command": "node build.mjs --production" } },
      "outputs": ["{projectRoot}/dist"]
    },
    "watch": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": { "command": "node build.mjs --watch", "cwd": "{projectRoot}" }
    },
    "typecheck": {}
  }
}
