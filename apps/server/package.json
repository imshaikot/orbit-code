    "@orbit-code/core": "workspace:*",
    "@orbit-code/indexer": "workspace:*",
    "@orbit-code/protocol": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@orbit-code/web-client": "workspace:*",
