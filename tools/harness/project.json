{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "harness",
  "projectType": "application",
  "sourceRoot": "tools/harness/src",
  "tags": ["type:tool", "runtime:browser"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node build.mjs", "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/dist"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": { "command": "node tools/harness/harness.mjs --skip-build" },
      "cache": false
    },
    "typecheck": {}
  }
}
